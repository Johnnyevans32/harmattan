    "/api/v1/wallets/{walletId}/deposits": {
      "post": {
        "description": "Credits the wallet immediately and records a DEPOSIT transaction.",
        "operationId": "WalletTransactionController_deposit",
        "parameters": [
          {
            "name": "walletId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "6720c0f1a2b3c4d5e6f70812",
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated unique key (UUID recommended). Retrying with the same key and payload returns the original transaction instead of moving money twice.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "7f9c2ba4-e88f-4c3b-9d1a-2f4e6b8a0c11"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay of an earlier identical request (Idempotent-Replayed: true)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "code": {
                          "type": "number",
                          "example": 200
                        },
                        "data": {
                          "$ref": "#/components/schemas/TransactionResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Processed",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "code": {
                          "type": "number",
                          "example": 201
                        },
                        "data": {
                          "$ref": "#/components/schemas/TransactionResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or Idempotency-Key missing",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "code": {
                          "type": "number",
                          "example": 400
                        },
                        "message": {
                          "type": "string",
                          "example": "Validation failed or Idempotency-Key missing"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Wallet not found",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "code": {
                          "type": "number",
                          "example": 404
                        },
                        "message": {
                          "type": "string",
                          "example": "Wallet not found"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Insufficient balance, or key reused with a different payload",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "code": {
                          "type": "number",
                          "example": 422
                        },
                        "message": {
                          "type": "string",
                          "example": "Insufficient balance, or key reused with a different payload"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Deposit funds (simulated)",
        "tags": [
          "Money Movement"
        ]
      }
    },
