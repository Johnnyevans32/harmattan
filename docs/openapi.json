                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "Get a transaction by id",
        "tags": [
          "Transactions"
        ]
      }
    }
  },
  "info": {
    "title": "Harmattan API",
    "description": "Multi-currency stablecoin wallet sandbox: wallets, simulated deposits, FX swaps and cross-border transfers across **cNGN, cGHS, cXAF, USDx and EURx**.\n\n### Conventions\n- Every response uses the envelope `{ code, message, data?, metadata?, errors? }`.\n- **Amounts are decimal strings** (e.g. `\"1500.25\"`), never JSON numbers, so no precision is lost to floating point. Each coin has 6 decimal places.\n- Money-moving endpoints require an **`Idempotency-Key`** header. Replaying a key with the same payload returns the original transaction with `200` and `Idempotent-Replayed: true`; reusing it with a different payload returns `422`.\n- FX conversions truncate to the destination coin's smallest unit and record the exact rate applied.\n\n### Quick start\n1. `POST /api/v1/wallets` twice to create a sender and a receiver.\n2. `POST /api/v1/wallets/{walletId}/deposits` to fund the sender.\n3. Try `/swaps` and `/transfers`, then read `/transactions`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Wallets",
      "description": "Create wallets and read balances"
    },
    {
      "name": "Money Movement",
      "description": "Deposits, swaps and transfers (idempotent)"
    },
    {
      "name": "Transactions",
      "description": "Transaction history"
    },
    {
      "name": "FX Rates",
      "description": "Conversion rates between supported stablecoins"
    },
    {
      "name": "Health",
      "description": "Service health"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "schemas": {
      "PaginationMetaDataDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "Current page number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "description": "Number of items per page",
            "example": 20
          },
          "totalDocs": {
            "type": "number",
            "description": "Total number of items",
            "example": 42
          },
          "prevPage": {
            "type": "number",
            "description": "Previous page number",
            "nullable": true,
            "example": null
          },
          "nextPage": {
            "type": "number",
            "description": "Next page number",
            "nullable": true,
            "example": 2
          },
          "totalPages": {
            "type": "number",
            "description": "Total count of pages",
            "example": 3
          }
        },
        "required": [
          "page",
          "limit",
          "totalDocs",
          "prevPage",
          "nextPage",
          "totalPages"
        ]
      },
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "HTTP status code",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "Human-readable message"
          },
          "data": {
            "type": "object",
            "description": "Response payload"
          },
          "metadata": {
            "$ref": "#/components/schemas/PaginationMetaDataDto"
          },
          "errors": {
            "description": "Validation errors, when the request was rejected",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "FxRateResponseDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx"
          },
          "to": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "rate": {
            "type": "string",
            "description": "Units of `to` received per 1 unit of `from`",
            "example": "1532.45"
          },
          "source": {
            "type": "string",
            "enum": [
              "LIVE",
              "FALLBACK"
            ],
            "description": "LIVE only when both legs come from the live provider"
          },
          "refreshedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When the older of the two legs was last refreshed",
            "example": "2026-10-29T12:00:00.000Z"
          },
          "stale": {
            "type": "boolean",
            "description": "True when the rate is older than the freshness threshold"
          }
        },
        "required": [
          "from",
          "to",
          "rate",
          "source",
          "refreshedAt",
          "stale"
        ]
      },
      "FxQuoteResponseDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx"
          },
          "to": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "rate": {
            "type": "string",
            "description": "Units of `to` received per 1 unit of `from`",
            "example": "1532.45"
          },
          "source": {
            "type": "string",
            "enum": [
              "LIVE",
              "FALLBACK"
            ],
            "description": "LIVE only when both legs come from the live provider"
          },
          "refreshedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When the older of the two legs was last refreshed",
            "example": "2026-10-29T12:00:00.000Z"
          },
          "stale": {
            "type": "boolean",
            "description": "True when the rate is older than the freshness threshold"
          },
          "amount": {
            "type": "string",
            "example": "100.000000"
          },
          "convertedAmount": {
            "type": "string",
            "description": "Amount in `to` currency, truncated to its smallest unit",
            "example": "153245.000000"
          }
        },
        "required": [
          "from",
          "to",
          "rate",
          "source",
          "refreshedAt",
          "stale",
          "amount",
          "convertedAmount"
        ]
      },
      "BalanceResponseDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "amount": {
            "type": "string",
            "example": "150000.000000"
          },
          "usdValue": {
            "type": "string",
            "description": "Equivalent value in USD",
            "example": "97.88"
          }
        },
        "required": [
          "currency",
          "amount",
          "usdValue"
        ]
      },
      "WalletResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6720c0f1a2b3c4d5e6f70812"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+2348012345678"
          },
          "balances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalanceResponseDto"
            }
          },
          "totalUsd": {
            "type": "string",
            "description": "Sum of all balances valued in USD at current rates",
            "example": "1097.88"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "balances",
          "totalUsd",
          "createdAt"
        ]
      },
      "CreateWalletDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Owner email. At least one of email or phone is required.",
            "example": "ada@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Owner phone number in international format.",
            "example": "+2348012345678"
          }
        }
      },
      "TransactionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6720c3a9a2b3c4d5e6f70a21"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "SWAP",
              "TRANSFER"
            ]
          },
          "senderWalletId": {
            "type": "string",
            "nullable": true,
            "description": "Null for deposits",
            "example": "6720c0f1a2b3c4d5e6f70812"
          },
          "receiverWalletId": {
            "type": "string",
            "example": "6720c0f1a2b3c4d5e6f70813"
          },
          "sourceCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "sourceAmount": {
            "type": "string",
            "example": "50000.000000"
          },
          "destinationCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cGHS"
          },
          "destinationAmount": {
            "type": "string",
            "example": "383.333333"
          },
          "rate": {
            "type": "string",
            "description": "Rate applied (1 when no conversion)",
            "example": "0.00766666666667"
          },
          "rateSource": {
            "type": "string",
            "enum": [
              "LIVE",
              "FALLBACK"
            ],
            "nullable": true,
            "description": "Null when no conversion happened"
          },
          "rateRefreshedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "Freshness of the rate applied"
          },
          "idempotencyKey": {
            "type": "string",
            "example": "7f9c2ba4-e88f-4c3b-9d1a-2f4e6b8a0c11"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "type",
          "senderWalletId",
          "receiverWalletId",
          "sourceCurrency",
          "sourceAmount",
          "destinationCurrency",
          "destinationAmount",
          "rate",
          "rateSource",
          "rateRefreshedAt",
          "idempotencyKey",
          "createdAt"
        ]
      },
      "DepositDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "amount": {
            "type": "string",
            "description": "Decimal string, up to 6 decimal places",
            "example": "250000.00"
          }
        },
        "required": [
          "currency",
          "amount"
        ]
      },
      "SwapDto": {
        "type": "object",
        "properties": {
          "fromCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN"
          },
          "toCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx"
          },
          "amount": {
            "type": "string",
            "description": "Amount of fromCurrency to sell",
            "example": "15000.00"
          }
        },
        "required": [
          "fromCurrency",
          "toCurrency",
          "amount"
        ]
      },
      "TransferDto": {
        "type": "object",
        "properties": {
          "recipientWalletId": {
            "type": "string",
            "description": "Receiving wallet id",
            "example": "6720c0f1a2b3c4d5e6f70813"
          },
          "sourceCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "description": "Coin debited from the sender",
            "example": "cNGN"
          },
          "destinationCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "description": "Coin credited to the recipient. Defaults to sourceCurrency; converted at the current FX rate when different.",
            "example": "cGHS"
          },
          "amount": {
            "type": "string",
            "description": "Amount of sourceCurrency to send",
            "example": "50000.00"
          }
        },
        "required": [
          "recipientWalletId",
          "sourceCurrency",
          "amount"
        ]
      }
    }
  }
}
